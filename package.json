{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "python server/app.py",
    "build": "vite build",
    "start": "python server/app.py",
    "build:win": "powershell -ExecutionPolicy Bypass -File installer/build.ps1",
    "build:win:exe": "powershell -ExecutionPolicy Bypass -File installer/build.ps1 -SkipInstaller",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "python3 -m pytest server/tests -q",
    "test:scale-runtime": "vitest run src/lib/__tests__/scale-runtime-client.test.ts src/lib/__tests__/weighing-scale-runtime-flow.test.ts src/lib/__tests__/stable-mode-matrix.test.ts src/lib/__tests__/manual-weight-reason.test.ts",
    "test:scale-parity": "vitest run src/lib/__tests__/scale-adapters-parity.test.ts src/lib/__tests__/scale-adapters-contract.test.ts src/lib/__tests__/scale-adapters-builtins.test.ts src/lib/__tests__/generic-regex-contract.test.ts",
    "test:scale-server": "python3 -m pytest server/tests/test_scale_api_contract.py server/tests/test_scale_api_security.py server/tests/test_scale_api_guard.py server/tests/test_scale_runtime_switch.py server/tests/test_scale_runtime_registry.py server/tests/test_scale_adapter_parity.py server/tests/test_scale_registry_contract.py server/tests/test_scale_registry_generic_regex.py server/tests/test_scale_integrity.py server/tests/test_serial_backend_transport.py -q"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.1.5",
    "vitest": "^3.2.7"
  }
}
